{
  "$meta": {
    "name": "CHU Blida Clinical Design System",
    "version": "1.0.0",
    "sources": {
      "logo": "brand/CHU_Blida.png",
      "website": "chublida.dz (WordPress + Woodmart 8.1.1)"
    },
    "note": "Single source of truth. Run `node tools/build-tokens.mjs` to regenerate the :root block in chu-theme.css and to assert every contrast pair below."
  },

  "brand": {
    "logoBlue": "#0057F1",
    "logoBlueMid": "#4286FF",
    "logoBlueLight": "#76AEFF",
    "logoGreen": "#3DD8AA",
    "siteTeal": "#29C093",
    "siteAmber": "#FBBC34",
    "siteDeepBlue": "#066AAB"
  },

  "primitive": {
    "teal": {
      "50": "#F3F9F7", "100": "#E5F3EF", "200": "#C8ECE1", "300": "#98E9D1",
      "400": "#68DFBB", "500": "#29C093", "600": "#26B389", "700": "#218C6C",
      "800": "#1A6C53", "900": "#13513E", "950": "#0D3629"
    },
    "blue": {
      "50": "#F1F5FB", "100": "#E1E9F6", "200": "#BED2F6", "300": "#82AFFF",
      "400": "#478AFF", "500": "#0A63FF", "600": "#004ED9", "700": "#0440A9",
      "800": "#033182", "900": "#022561", "950": "#021841"
    },
    "amber": {
      "50": "#FBF8F1", "100": "#F6F0E2", "200": "#F5E4BF", "300": "#FDD784",
      "400": "#FBC44B", "500": "#FAB00F", "600": "#D59304", "700": "#A67408",
      "800": "#805906", "900": "#604304"
    },
    "red": {
      "50": "#FDECEA", "100": "#FBD9D5", "200": "#F5B0A9", "500": "#DA3B31",
      "600": "#B3261E", "700": "#8C1D17", "800": "#6B1611"
    },
    "neutral": {
      "0": "#FFFFFF", "25": "#FBFCFC", "50": "#F6F8F7", "100": "#EEF2F0",
      "200": "#DCE5E1", "300": "#C4D2CC", "400": "#7C8F88", "500": "#657570",
      "600": "#4A5B55", "700": "#33433D", "800": "#1E2E28", "900": "#12211C",
      "950": "#0A1512"
    }
  },

  "semantic": {
    "canvas":          { "value": "neutral.50",  "comment": "app background" },
    "surface":         { "value": "neutral.0",   "comment": "cards, header, tables" },
    "surface-sunken":  { "value": "teal.50" },
    "surface-raised":  { "value": "neutral.0" },
    "surface-brand":   { "value": "teal.950",    "comment": "inverted areas" },

    "ink":             { "value": "neutral.900" },
    "ink-muted":       { "value": "neutral.600" },
    "ink-subtle":      { "value": "neutral.500" },
    "ink-inverse":     { "value": "neutral.0" },

    "action":          { "value": "teal.800",    "comment": "primary buttons; white text 6.34:1" },
    "action-hover":    { "value": "teal.900" },
    "action-soft":     { "value": "teal.100" },
    "action-quiet":    { "value": "teal.700",    "comment": "icons and borders; >=3:1" },

    "link":            { "value": "blue.600" },
    "link-hover":      { "value": "blue.700" },
    "focus":           { "value": "blue.500" },

    "brand-vivid":     { "value": "teal.500",    "comment": "DECORATIVE ONLY - 2.32:1, never text or a meaningful edge" },
    "brand-blue":      { "value": "brand.logoBlue", "comment": "DECORATIVE ONLY" },

    "border":          { "value": "neutral.200", "comment": "decorative dividers" },
    "border-strong":   { "value": "neutral.300" },
    "border-control":  { "value": "neutral.400", "comment": "meaningful control outlines; >=3:1" },

    "critical":        { "value": "red.600" },
    "critical-bg":     { "value": "red.50" },
    "warning":         { "value": "amber.800" },
    "warning-bg":      { "value": "amber.100" },
    "success":         { "value": "teal.800" },
    "success-bg":      { "value": "teal.100" },
    "info":            { "value": "blue.700" },
    "info-bg":         { "value": "blue.100" }
  },

  "scale": {
    "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px" },
    "radius": { "sm": "4px", "md": "8px", "lg": "12px", "xl": "18px", "pill": "999px" },
    "shadow": {
      "1": "0 1px 2px rgba(18,33,28,.06), 0 1px 3px rgba(18,33,28,.08)",
      "2": "0 2px 6px rgba(18,33,28,.07), 0 6px 16px rgba(18,33,28,.09)",
      "3": "0 8px 24px rgba(18,33,28,.10), 0 16px 48px rgba(18,33,28,.12)",
      "rail": "0 0 0 1px rgba(18,33,28,.05), 8px 0 28px rgba(18,33,28,.10)"
    },
    "font": {
      "ui": "\"Inter\", \"Segoe UI\", system-ui, -apple-system, \"Helvetica Neue\", Arial, sans-serif",
      "display": "\"Cairo\", \"Inter\", \"Segoe UI\", system-ui, sans-serif",
      "mono": "\"JetBrains Mono\", \"Cascadia Mono\", Consolas, \"Courier New\", monospace"
    },
    "size": {
      "xs": "12px", "sm": "13px", "base": "14px", "md": "15px",
      "lg": "16px", "xl": "20px", "2xl": "24px", "3xl": "28px"
    },
    "duration": { "instant": "90ms", "fast": "140ms", "base": "220ms", "slow": "320ms" },
    "ease": {
      "out": "cubic-bezier(.22,.8,.28,1)",
      "in": "cubic-bezier(.5,0,.75,0)",
      "spring": "cubic-bezier(.34,1.42,.64,1)"
    },
    "layout": {
      "rail-collapsed": "56px",
      "rail-expanded": "248px",
      "panel-width": "380px",
      "header-height": "58px",
      "content-max": "1600px"
    }
  },

  "contrastContract": [
    { "fg": "semantic.ink",            "bg": "semantic.surface",  "min": 4.5,  "why": "body text" },
    { "fg": "semantic.ink",            "bg": "semantic.canvas",   "min": 4.5,  "why": "body text on app background" },
    { "fg": "semantic.ink-muted",      "bg": "semantic.surface",  "min": 4.5,  "why": "labels and table headers" },
    { "fg": "semantic.ink-muted",      "bg": "semantic.canvas",   "min": 4.5,  "why": "labels on app background" },
    { "fg": "semantic.ink-subtle",     "bg": "semantic.surface",  "min": 4.5,  "why": "secondary and meta text" },
    { "fg": "semantic.ink-subtle",     "bg": "semantic.canvas",   "min": 4.5,  "why": "meta text on app background" },
    { "fg": "semantic.ink-inverse",    "bg": "semantic.action",   "min": 4.5,  "why": "primary button label" },
    { "fg": "semantic.ink-inverse",    "bg": "semantic.action-hover", "min": 4.5, "why": "primary button hover label" },
    { "fg": "semantic.link",           "bg": "semantic.surface",  "min": 4.5,  "why": "links" },
    { "fg": "semantic.link-hover",     "bg": "semantic.surface",  "min": 4.5,  "why": "link hover" },
    { "fg": "semantic.action-quiet",   "bg": "semantic.surface",  "min": 3.0,  "why": "icons and control accents" },
    { "fg": "semantic.focus",          "bg": "semantic.surface",  "min": 3.0,  "why": "focus ring" },
    { "fg": "semantic.border-control", "bg": "semantic.surface",  "min": 3.0,  "why": "input outline" },
    { "fg": "semantic.border-control", "bg": "semantic.canvas",   "min": 3.0,  "why": "input outline on app background" },
    { "fg": "semantic.critical",       "bg": "semantic.surface",  "min": 4.5,  "why": "critical status text" },
    { "fg": "semantic.critical",       "bg": "semantic.critical-bg", "min": 4.5, "why": "critical banner text" },
    { "fg": "semantic.warning",        "bg": "semantic.surface",  "min": 4.5,  "why": "warning status text" },
    { "fg": "semantic.warning",        "bg": "semantic.warning-bg", "min": 4.5, "why": "warning banner text" },
    { "fg": "semantic.success",        "bg": "semantic.surface",  "min": 4.5,  "why": "success status text" },
    { "fg": "semantic.success",        "bg": "semantic.success-bg", "min": 4.5, "why": "success banner text" },
    { "fg": "semantic.info",           "bg": "semantic.surface",  "min": 4.5,  "why": "info status text" },
    { "fg": "semantic.info",           "bg": "semantic.info-bg",  "min": 4.5,  "why": "info banner text" },
    { "fg": "semantic.ink-inverse",    "bg": "semantic.surface-brand", "min": 4.5, "why": "text on inverted surfaces" },
    { "fg": "semantic.ink",            "bg": "semantic.action-soft", "min": 4.5, "why": "text on selected rows" }
  ],

  "decorativeOnly": [
    "semantic.brand-vivid",
    "semantic.brand-blue",
    "semantic.border",
    "semantic.border-strong"
  ]
}
